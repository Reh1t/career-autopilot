{
  "manifest_version": 3,
  "name": "Career Autopilot",
  "version": "1.0",
  "description": "Autofills job applications with AI-tailored content.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://boards.greenhouse.io/*", "https://jobs.lever.co/*"],
      "js": ["content.js"]
    }
  ]
}
